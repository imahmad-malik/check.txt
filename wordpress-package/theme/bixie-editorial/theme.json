{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "linen",
          "name": "Linen",
          "color": "#f3f0e8"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#252623"
        },
        {
          "slug": "moss",
          "name": "Moss",
          "color": "#34453c"
        },
        {
          "slug": "copper",
          "name": "Copper",
          "color": "#9b613e"
        },
        {
          "slug": "chalk",
          "name": "Chalk",
          "color": "#fffdf8"
        },
        {
          "slug": "stone",
          "name": "Stone",
          "color": "#dfddd3"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "1rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "2rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "4rem"
        },
        {
          "slug": "section",
          "name": "Section",
          "size": "6rem"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "'DM Sans',Arial,sans-serif",
          "name": "DM Sans",
          "slug": "sans",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/dm-sans-latin-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "500",
              "src": [
                "file:./assets/fonts/dm-sans-latin-500-normal.woff2"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": [
                "file:./assets/fonts/dm-sans-latin-600-normal.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "'Instrument Serif',Georgia,serif",
          "name": "Instrument Serif",
          "slug": "serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/instrument-serif-latin-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "italic",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/instrument-serif-latin-400-italic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "caption",
          "name": "Caption",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "section",
          "name": "Section title",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5rem",
          "fluid": {
            "min": "2.75rem",
            "max": "5rem"
          }
        }
      ]
    },
    "blocks": {
      "core/image": {
        "lightbox": {
          "allowEditing": true
        }
      },
      "core/gallery": {
        "spacing": {
          "blockGap": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|linen",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "500",
          "lineHeight": "1.08",
          "letterSpacing": "-0.04em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|moss",
          "text": "var:preset|color|chalk"
        },
        "border": {
          "radius": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.4rem",
            "right": "1.4rem"
          }
        },
        "typography": {
          "fontWeight": "500",
          "fontSize": "0.9rem"
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|caption",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/image": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "500"
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "600",
          "fontSize": "1.35rem",
          "letterSpacing": "-0.05em"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var:preset|font-size|section"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-home",
      "title": "Photo collection home",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "collection",
      "title": "Photo collection",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "guide",
      "title": "Hair guide",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
